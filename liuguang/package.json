{
  "name": "dsh-theme-liuguang",
  "version": "0.3.1",
  "private": false,
  "description": "Liuguang (琉光) — DeepSeek Harness skin with two switchable design languages: liquid glass and Soviet constructivism, plus a personalization panel, drop-in CSS skin packs and a whale-girl desktop pet.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-theme",
    "dsh-skin",
    "deepseek-harness",
    "deepseek",
    "harness",
    "skin",
    "theme",
    "liquid-glass",
    "glassmorphism",
    "constructivism",
    "soviet-constructivism",
    "bauhaus",
    "desktop-pet",
    "aurora",
    "liuguang",
    "琉光",
    "液态玻璃",
    "苏联构成主义",
    "皮肤",
    "主题",
    "桌宠"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./theme.css": "./lib/liuguang.css"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      },
      "note": "Styled through --dsw-* tokens plus semantic hooks ([data-composer-card], [data-conversation-content], [data-sidebar-right-panel][data-sidebar-right-open], role=treeitem[aria-selected]); no CSS-module class names are referenced."
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check:contrast": "node tools/palette.mjs --check",
    "palette": "node tools/palette.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShokouP/dsh-theme-liuguang.git"
  },
  "homepage": "https://github.com/ShokouP/dsh-theme-liuguang#readme",
  "bugs": {
    "url": "https://github.com/ShokouP/dsh-theme-liuguang/issues"
  },
  "dependencies": {},
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/liuguang.css",
    "src",
    "tools",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
